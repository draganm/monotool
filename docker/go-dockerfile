# syntax=docker/dockerfile:1
FROM golang:{{.GoVersion}} as builder
WORKDIR /build
ADD . /build/
RUN mkdir /out
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod/ CGO_ENABLED=1 go build -ldflags="-w -s -linkmode external -extldflags '-static'" -o /out/service ./{{.PackagePath}}

FROM alpine
RUN apk add --no-cache
WORKDIR /app
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /out/service /app
ENTRYPOINT ["/app/service"]